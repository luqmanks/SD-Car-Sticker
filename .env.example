SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=

# While testing, every SMS and call goes to this number instead of the car owner. REMOVE before going live.
TEST_PHONE_OVERRIDE=

# Zavu SMS: https://dashboard.zavu.dev > Settings > API Keys
ZAVU_API_KEY=
# Optional: pin a sender (otherwise the project's default sender is used)
ZAVU_SENDER_ID=
